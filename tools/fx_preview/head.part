<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>WeatherScope Wetter-Animation</title>
<style>
/* VOICE: ruhig, atmosphärisch, wie ein Blick aus dem Fenster bei Regen
   IDEA: die WeatherScope-Wetterseite als Fensterscheibe, hinter und auf der das Wetter passiert
   PICTURE: der ganze Bildschirm – Wolken, Regen/Schnee hinter Glaskacheln, Tropfen und Schnee auf den Kacheln
   COLOUR and TYPE: Grautöne des Himmels je Wetterlage, Glaskacheln, weiße Schrift; Schrift von Home Assistant (Roboto)
   LAYOUT: Kopf mittig, quadratisches Kachelraster wie die Wetterseite, schmale Bedienleiste unten */
:root{color-scheme:dark}
*{box-sizing:border-box;min-width:0}
html,body{margin:0;min-height:100%}
body{background:#3d4652;color:#fff;font:16px/1.4 Roboto,"Noto Sans",system-ui,sans-serif;overflow-x:clip}
#bg,#fx{position:fixed;inset:0;width:100vw;height:100vh;display:block}
#bg{z-index:0}#fx{z-index:2;pointer-events:none}
main{position:relative;z-index:1;max-width:1080px;margin:0 auto;padding:28px 16px 170px}
.head{text-align:center;margin-bottom:22px;text-shadow:0 1px 3px rgba(0,0,0,.3)}
.head .o{font-size:22px}.head .t{font-size:88px;font-weight:300;line-height:1;margin-left:.12em}.head .c{font-size:17px;font-weight:500;margin-top:4px}.head .h{font-size:15px;opacity:.9;margin-top:2px}
.grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;grid-auto-rows:150px}
.tile{border-radius:18px;padding:12px;background:rgba(28,40,62,var(--glass,.30));transition:background .8s;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.13);overflow:hidden;display:flex;flex-direction:column}
.w2{grid-column:span 2}.w4{grid-column:span 4}.h3{grid-row:span 3}
.lab{font-size:11px;letter-spacing:.03em;text-transform:uppercase;opacity:.7}
.big{font-size:30px;margin-top:6px}.sub{font-size:13px;margin-top:2px}.note{font-size:12px;opacity:.7;margin-top:auto}
.hours{display:flex;justify-content:space-between;margin-top:auto;font-size:13px;text-align:center}.hours b{display:block;font-weight:400;opacity:.7;font-size:12px;margin-bottom:6px}.hours span{display:block;margin-top:6px}
.days{display:flex;flex-direction:column;justify-content:space-around;flex:1;font-size:13px}.days div{display:grid;grid-template-columns:3em 1fr 4.5em;align-items:center;gap:8px;border-top:1px solid rgba(255,255,255,.1);padding-top:6px}.days div:first-child{border:0}
.days i{height:6px;border-radius:3px;background:rgba(0,0,0,.22);position:relative}.days i:after{content:"";position:absolute;inset:0 var(--r) 0 var(--l);border-radius:3px;background:linear-gradient(90deg,#7fd4ff,#ffd36b)}
.map{flex:1;margin-top:8px;border-radius:12px;background:repeating-linear-gradient(45deg,rgba(90,200,250,.10) 0 12px,rgba(90,200,250,.04) 12px 24px);display:grid;place-items:center;font-size:12px;opacity:.8}
.panel{position:fixed;z-index:3;left:50%;bottom:12px;transform:translateX(-50%);width:min(1040px,calc(100vw - 16px));background:rgba(14,19,27,.78);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:10px 12px;display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;font-size:13px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chips button,.panel .btn{font:inherit;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);border-radius:999px;padding:0 14px;height:36px;cursor:pointer}
.chips button[aria-pressed=true]{background:#fff;color:#1b2430;border-color:#fff}
.panel label{display:flex;align-items:center;gap:8px;white-space:nowrap}
.panel input[type=range]{width:120px;accent-color:#7fd4ff}
.panel select{font:inherit;font-size:14px;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);border-radius:10px;height:36px;padding:0 8px}
.panel select option{color:#000}
.panel output{min-width:4.8em;display:inline-block;font-variant-numeric:tabular-nums}
.panel input[type=checkbox]{width:18px;height:18px;accent-color:#7fd4ff}
.hint{font-size:12px;opacity:.6;width:100%}
:focus-visible{outline:2px solid #7fd4ff;outline-offset:2px}
@media(max-width:700px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.w4{grid-column:span 2}.head .t{font-size:64px}.panel input[type=range]{width:90px}}
</style>
</head>
<body>
<canvas id="bg" aria-hidden="true"></canvas>
<main>
  <div class="head"><div class="o">Heilbronn</div><div class="t">5°</div><div class="c" id="cond">Regen</div><div class="h">H: 6° T: 0°</div></div>
  <div class="grid" id="grid">
    <div class="tile w4"><div class="lab">Stündlich · Niederschlag</div>
      <div class="hours"><div><b>Jetzt</b>☂<span>0,8</span></div><div><b>16</b>☂<span>1,2</span></div><div><b>17</b>☂<span>0,9</span></div><div><b>18</b>☂<span>0,4</span></div><div><b>19</b>☂<span>0,2</span></div><div><b>20</b>☂<span>0</span></div><div><b>21</b>☂<span>0</span></div></div></div>
    <div class="tile"><div class="lab">Gefühlt</div><div class="big">2°</div><div class="sub">Tatsächlich: 5°</div><div class="note">Durch den Wind ist es gefühlt kälter.</div></div>
    <div class="tile"><div class="lab">Wind</div><div class="big" id="windv">20 km/h</div><div class="sub" id="windd">aus Westen</div><div class="note">Böen bis 35 km/h</div></div>
    <div class="tile w2 h3"><div class="lab">10 Tage</div><div class="days" id="days"></div></div>
    <div class="tile w2 h3"><div class="lab">Wetterkarte</div><div class="map">Karte (Platzhalter)</div></div>
    <div class="tile w2"><div class="lab">Niederschlag</div><div class="big">4,2 mm</div><div class="sub">Heute</div><div class="note">Morgen 1,1 mm erwartet.</div></div>
    <div class="tile"><div class="lab">Luftdruck</div><div class="big">1.009</div><div class="sub">hPa · fallend</div></div>
    <div class="tile"><div class="lab">Feuchtigkeit</div><div class="big">94 %</div><div class="note">Taupunkt 4°</div></div>
    <div class="tile"><div class="lab">Sichtweite</div><div class="big">6 km</div><div class="note">Leicht eingeschränkt.</div></div>
    <div class="tile"><div class="lab">UV-Index</div><div class="big">0</div><div class="sub">Niedrig</div></div>
  </div>
</main>
<canvas id="fx" aria-hidden="true"></canvas>
<div class="panel" role="group" aria-label="Wetter einstellen">
  <div class="chips" id="modes">
    <button data-m="sunny">Sonnig</button><button data-m="partly">Heiter</button><button data-m="dry">Trocken</button><button data-m="drizzle">Niesel</button><button data-m="rain" aria-pressed="true">Regen</button><button data-m="heavy">Starkregen</button><button data-m="sleet">Schneeregen</button><button data-m="snow">Leichter Schnee</button><button data-m="snowh">Starker Schnee</button><button data-m="storm">Gewitter</button>
  </div>
  <label>Wind <input type="range" id="wind" min="0" max="90" step="1" value="20"><output id="windo">20 km/h</output></label>
  <label>aus <select id="dir"><option value="270" selected>Westen</option><option value="225">Südwesten</option><option value="180">Süden</option><option value="135">Südosten</option><option value="90">Osten</option><option value="45">Nordosten</option><option value="0">Norden</option><option value="315">Nordwesten</option></select></label>
  <label>Temperatur <input type="range" id="temp" min="-10" max="10" step="1" value="-2"><output id="tempo">−2 °C</output></label>
  <label><input type="checkbox" id="ontiles" checked> Wetter auf Kacheln</label>
  <label>Tageszeit <select id="tod"><option value="morning">Morgen</option><option value="day" selected>Tag</option><option value="evening">Abend</option><option value="night">Nacht</option></select></label>
  <label>Sonnenstand <input type="range" id="sunp" min="0" max="100" value="50"> <span id="sunpv"></span></label>
  <label>Jahreszeit <select id="season"><option value="winter">Winter</option><option value="mid" selected>Frühling/Herbst</option><option value="summer">Sommer</option></select></label>
  <label>Nordlicht <select id="aur"><option value="0">aus</option><option value="1">schwach</option><option value="2">mittel</option><option value="3">stark</option></select></label>
  <label>Nebel <select id="fog"><option value="0">aus</option><option value="1">Dunst</option><option value="2">Nebel</option><option value="3">dicht</option></select></label>
  <label>Zeitraffer <select id="speed"><option value="1">1×</option><option value="10">10×</option><option value="30">30×</option></select></label>
  <button class="btn" id="reset">Zurücksetzen</button><button class="btn" id="clear">Schnee entfernen</button>
  <div class="hint">Stand 55 · Vorschau mit Beispielwerten. Schnee bleibt liegen und taut erst über 0 °C. Zeitraffer beschleunigt Liegenbleiben, Abrutschen und Tauen.</div>
</div>
