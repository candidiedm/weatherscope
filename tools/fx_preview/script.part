    F.globalAlpha = 0.8;
    R.forEach((r, i) => {
      const o = T[i];
      if (o.mist && o.mist.length) { F.globalAlpha = 1; F.fillStyle = 'rgba(220,230,240,.22)'; F.beginPath(); for (const m of o.mist) F.rect(r.left + m[0], r.top + m[1], m[2] * 2, m[2] * 2); F.fill(); F.fillStyle = 'rgba(10,15,22,.16)'; F.beginPath(); for (const m of o.mist) F.rect(r.left + m[0], r.top + m[1] - 0.6, m[2] * 2, 0.6); F.fill(); }
      if (!o.drops.length && !o.rivs.length && !o.merging.length && !o.splats.length) return;
      F.globalAlpha = 0.72; // a little see-through so values stay readable
      for (const d of [...o.drops, ...o.merging]) { F.globalAlpha = d.fi ? 0.72 * Math.min(1, (t - d.fi) / 0.5) : 0.72; const sp = SPR[d.s], wb = (d.wob ? 1 + 0.3 * d.wob * Math.sin(t * 38) : 1) * (d.age !== undefined && d.age < 0.16 ? 1 + (d.r > 2.5 ? 0.6 : 0.35) * (1 - d.age / 0.16) : 1), w = d.r * 3.6 * wb, h = d.r * 3.6 * d.el / wb; if (d.rot) { F.save(); F.translate(r.left + d.x, r.top + d.y); F.rotate(d.rot); F.drawImage(sp.cv, -w / 2, -h / 2, w, h); F.restore(); } else F.drawImage(sp.cv, r.left + d.x - w / 2, r.top + d.y - h / 2, w, h); }
