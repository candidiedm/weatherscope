            F.moveTo(r.left + p0[0] + (p0[6] || 0) - half(n) * (p0[4] || 1), r.top + p0[1]); F.lineTo(r.left + p1[0] + (p1[6] || 0) - half(n + 1) * (p1[4] || 1), r.top + p1[1] + 0.4);
            F.lineTo(r.left + p1[0] + (p1[6] || 0) + half(n + 1) * (p1[5] || 1), r.top + p1[1] + 0.4); F.lineTo(r.left + p0[0] + (p0[6] || 0) + half(n) * (p0[5] || 1), r.top + p0[1]); F.closePath(); F.fill();
          }
        }
        if (v.mode === 'run') { const sp = SPR[v.s || 0], w = v.r * 2.7, h = w * (1.2 + Math.min(0.5, v.v / 1500)); F.drawImage(sp.cv, r.left + v.x - w / 2, r.top + v.y - h * 0.6, w, h); }
      }
      // splash of a big raindrop: a wide, flat, irregular smear for a moment
      for (const sp of o.splats) { const g = 1 + sp.t * 5; for (const [ox, oy, si, sc] of sp.parts) { const w = sp.r * 3.6 * sc * g, h = w * 0.6; F.drawImage(SPR[si].cv, r.left + sp.x + ox * sp.r * 2 - w / 2, r.top + sp.y + oy * sp.r * 2 - h / 2, w, h); } }
      F.globalAlpha = 0.8;
    });
    F.globalAlpha = 1;
    F.fillStyle = 'rgba(210,225,240,.7)';
    for (const d of falls) { const sp = SPR[20], w = d.r * 3.4, h = w * 1.4; F.drawImage(sp.cv, d.x - w / 2, d.y - h / 2, w, h); }
    // hanging drops: a teardrop under the edge with a narrow neck
    R.forEach((r, i) => { for (const p of T[i].pool) { const x = r.left + p.x, b = r.bottom - 0.5, q = p.r * 1.9, st = p.st * 1.9;
      F.beginPath(); F.moveTo(x - q * 0.5, b); F.bezierCurveTo(x - q * 0.45, b + st * 0.6 + q * 0.4, x - q * 1.1, b + st + q * 0.9, x - q * 0.8, b + st + q * 1.6); F.arc(x, b + st + q * 1.35, q * 0.85, Math.PI * 0.85, Math.PI * 0.15, true); F.bezierCurveTo(x + q * 1.1, b + st + q * 0.9, x + q * 0.45, b + st * 0.6 + q * 0.4, x + q * 0.5, b); F.closePath();
      F.fillStyle = 'rgba(190,205,222,.30)'; F.fill(); F.strokeStyle = 'rgba(14,20,30,.55)'; F.lineWidth = 1.3; F.stroke();
      F.fillStyle = 'rgba(255,255,255,.75)'; F.beginPath(); F.arc(x - q * 0.35, b + st + q * 1.05, Math.max(0.6, q * 0.28), 0, 6.3); F.fill();
      F.fillStyle = 'rgba(255,255,255,.3)'; F.beginPath(); F.arc(x, b + st + q * 1.35, q * 0.7, 0.3, Math.PI - 0.3); F.fill(); } });
    F.fillStyle = 'rgba(225,235,245,.8)';
    for (const s of splash) F.fillRect(s.x, s.y, 1.3, 1.3);
    // snow caps
    R.forEach((r, i) => {
      const o = T[i]; if (!o.cap && !o.heaps.length) return; const c = capOf(i, r); let any = o.heaps.length > 0; for (let k = 0; k < c.length && !any; k++) if (c[k] > 0.12) any = true; if (!any) return;
      const gr = F.createLinearGradient(0, r.top - (o.maxh || MAXH) - 2, 0, r.top + 1); gr.addColorStop(0, '#ffffff'); gr.addColorStop(0.7, '#f1f5f9'); gr.addColorStop(1, '#cfd9e4');
      F.fillStyle = gr; smoothCap(r, c, o.ov, o); F.fill();
      overhang(r, c, o, 0); overhang(r, c, o, 1);
      for (const hp of o.heaps) { // fresh heap: a soft mound on top of the cap
        const x0 = r.left + hp.x, k0 = Math.max(0, Math.min(c.length - 1, Math.round(hp.x / COL))), base = edgeY(r, x0) + 0.6 - c[k0];
        F.fillStyle = gr; F.beginPath(); F.moveTo(x0 - hp.w, base + 1);
        for (let dx = -hp.w; dx <= hp.w; dx += 1) { const e = dx / (hp.w * 0.5); F.lineTo(x0 + dx, base - hp.h * Math.exp(-e * e) * (1 + 0.06 * Math.sin(dx * 0.35 + hp.x))); }
        F.lineTo(x0 + hp.w, base + 1); F.closePath(); F.fill();
      }
    });
    for (const c of clumps) { if (c.delay > 0) continue; F.fillStyle = c.r > 2 ? '#f6f9fc' : 'rgba(255,255,255,.95)'; F.beginPath(); F.ellipse(c.x, c.y, c.r * c.sh, c.r / c.sh, c.rot, 0, 6.3); if (c.r > 1.2 && c.lobes) for (const [ox, oy, rr] of c.lobes) { const cs = Math.cos(c.rot), sn = Math.sin(c.rot), X = c.x + (ox * cs - oy * sn) * c.r, Y = c.y + (ox * sn + oy * cs) * c.r; F.moveTo(X + rr * c.r, Y); F.arc(X, Y, rr * c.r, 0, 6.3); } F.fill(); }
    F.fillStyle = 'rgba(255,255,255,.6)';
    for (const p of powder) { if (p.delay > 0) continue; if (p.veil) { F.globalAlpha = Math.min(1, p.life) * 0.18; F.beginPath(); F.arc(p.x, p.y, p.veil * (1 + (2 - p.life) * 0.4), 0, 6.3); F.fill(); } else { F.globalAlpha = Math.min(1, p.life) * 0.8; F.fillRect(p.x, p.y, 1.3, 1.3); } }
    F.globalAlpha = 1;
  }
  if (S.fog) { // a light veil of fog in front of the tiles too – values stay readable
    const fa = [0, 0.1, 0.18, 0.28][S.fog] * (S.tod === 'night' ? 0.3 : 1); F.globalAlpha = fa;
    fogL.slice(0, S.fog).forEach((l, li) => { const b = Math.sin(t * 2 * Math.PI / (21 + li * 6) + li); F.globalAlpha = fa * (0.7 + 0.3 * b); for (let x = snapX(l.ox) - l.LW; x < W; x += l.LW) F.drawImage(l.cv, x, -0.025 * (b + 1) * H, l.LW, H * (1 + 0.05 * (b + 1))); });
    // wisps that waver over the tiles: they thicken and thin, rise and sink, stretch and dissolve
    const wa = [0, 0.16, 0.26, 0.34][S.fog] * (S.tod === 'night' ? 0.3 : 1);
    const swell = 1 + 0.15 * Math.sin(t * 2 * Math.PI / 90); // the fog as a whole thickens and thins over a minute or two
    for (const w of wisps) {
      // each patch breathes: spreads out and thins, pulls back and thickens, in its own rhythm
      const env = Math.min(1, w.life / 8, (w.max - w.life) / 8), b = Math.sin(t * 2 * Math.PI / w.per + w.ph), b2 = Math.sin(t * 2 * Math.PI / w.per2 + w.ph * 1.7);
      const sc = w.sc * (1 + 0.35 * b), dens = 0.55 + 0.3 * b2 - 0.15 * b;
      F.globalAlpha = Math.max(0, Math.min(1, wa * env * dens * swell)); const cv = WISP[w.s], dw = cv.width * sc * (1 + 0.15 * b2), dh = cv.height * sc;
      F.drawImage(cv, w.cx - dw / 2, w.cy - dh / 2, dw, dh);
    }
    F.globalAlpha = 1; F.fillStyle = `rgba(${fogGrey()},${[0, 0.03, 0.06, 0.1][S.fog]})`; F.fillRect(0, 0, W, H);
  }
  if (m.clear && S.tod !== 'night' && S.fog < 2) { // rarely a soft gleam glides over the glass
    if (shimmer.t < 0 && (shimmer.next -= 0.033) <= 0) shimmer.t = 0;
    if (shimmer.t >= 0) {
      shimmer.t += 0.033; const p = shimmer.t / 2.2, bx = -W * 0.3 + p * W * 1.6;
      F.save(); F.beginPath(); for (const r of R) F.roundRect(r.left, r.top, r.width, r.height, 18); F.clip();
      const sg = F.createLinearGradient(bx - 140, 0, bx + 140, H * 0.4); sg.addColorStop(0, 'rgba(255,255,255,0)'); sg.addColorStop(0.5, 'rgba(255,255,255,.07)'); sg.addColorStop(1, 'rgba(255,255,255,0)');
      F.fillStyle = sg; F.fillRect(0, 0, W, H); F.restore();
      if (p >= 1) { shimmer.t = -1; shimmer.next = rnd(60, 120); }
    }
  }
  if (flash > 0) { F.fillStyle = `rgba(215,225,255,${flash * 0.18})`; F.fillRect(0, 0, W, H); }
}

function frame(ts) {
  requestAnimationFrame(frame);
  if (document.hidden) { last = ts; return; }
  if (ts - last < 32) return; // at most about 30 frames per second
  const dt = Math.min(0.05, (ts - last) / 1000 || 0.03); last = ts; t += dt;
  step(dt); draw();
}

// remember the snow on the tiles (this browser only)
function save() { try { localStorage.setItem('wsfx-caps2', JSON.stringify(T.map((o) => (o.cap ? Array.from(o.cap, (v) => Math.round(v * 10) / 10) : null)))); } catch (e) {} }
function load() { try { const a = JSON.parse(localStorage.getItem('wsfx-caps2') || 'null'); if (Array.isArray(a)) a.forEach((c, i) => { if (c && i < T.length) T[i].cap = Float32Array.from(c); }); } catch (e) {} }

const fmtT = (v) => `${v < 0 ? '−' : ''}${Math.abs(v)} °C`;
const dirName = () => document.getElementById('dir').selectedOptions[0].textContent;
function ui() {
  document.getElementById('windo').textContent = `${S.wind} km/h`;
  document.getElementById('windv').textContent = `${S.wind} km/h`;
  document.getElementById('windd').textContent = `aus ${dirName()}`;
  document.getElementById('tempo').textContent = fmtT(S.temp);
}
document.getElementById('modes').addEventListener('click', (e) => {
  const b = e.target.closest('button'); if (!b) return;
  S.mode = b.dataset.m; document.querySelectorAll('#modes button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  if (S.mode.startsWith('snow') && S.temp > 0) { S.temp = -2; document.getElementById('temp').value = -2; ui(); }
  makeClouds(); fill(); if (reduce) draw();
});
document.getElementById('wind').addEventListener('input', (e) => { S.wind = +e.target.value; ui(); });
document.getElementById('dir').addEventListener('change', (e) => { S.dir = +e.target.value; ui(); });
document.getElementById('temp').addEventListener('input', (e) => { S.temp = +e.target.value; ui(); });
document.getElementById('ontiles').addEventListener('change', (e) => { S.on = e.target.checked; });
function sunFromPanel() { // position of the sun from the two preview controls: part of the day and season
  const p = +document.getElementById('sunp').value / 100, se = document.getElementById('season').value, mx = { winter: 17, mid: 41, summer: 64 }[se], half = { winter: 55, mid: 90, summer: 128 }[se];
  S.sunAz = 180 + (p * 2 - 1) * half; S.sunEl = mx * Math.pow(Math.sin(Math.PI * p), 0.85);
  document.getElementById('sunpv').textContent = `${Math.round(S.sunEl)}°`;
  if (S.tod !== 'night') { const td = S.sunEl < 8 ? (p < 0.5 ? 'morning' : 'evening') : 'day'; if (td !== S.tod) { S.tod = td; document.getElementById('tod').value = td; makeClouds(); fill(); } }
}
document.getElementById('sunp').addEventListener('input', sunFromPanel); document.getElementById('season').addEventListener('change', sunFromPanel);
document.getElementById('tod').addEventListener('change', (e) => { S.tod = e.target.value; const v = { morning: 7, day: 50, evening: 93 }[S.tod]; if (v !== undefined) { document.getElementById('sunp').value = v; sunFromPanel(); } makeClouds(); fill(); });
document.getElementById('aur').addEventListener('change', (e) => { S.aurora = +e.target.value; });
document.getElementById('fog').addEventListener('change', (e) => { S.fog = +e.target.value; fill(); });
document.getElementById('speed').addEventListener('change', (e) => { S.speed = +e.target.value; });
document.getElementById('reset').addEventListener('click', () => { T.forEach((o) => { o.cap = null; o.lim = null; o.ov = [0, 0]; o.sag = [null, null]; o.heaps = []; o.drops = []; o.rivs = []; o.merging = []; o.splats = []; o.pool = []; o.mist = []; o.cleared = []; }); wetStart = t; splash = []; clumps = []; powder = []; falls = []; lines = []; bolt = null; flash = 0; save(); });
document.getElementById('clear').addEventListener('click', () => { T.forEach((o) => { o.cap = null; o.ov = [0, 0]; }); slabs = []; save(); });
addEventListener('resize', size);
load(); size(); ui();
sunFromPanel();
setInterval(save, 5000);
if (reduce) draw(); else requestAnimationFrame(frame);
}
