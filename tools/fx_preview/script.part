<script>
{
const bg = document.getElementById('bg'), fx = document.getElementById('fx'), B = bg.getContext('2d'), F = fx.getContext('2d');
const grid = document.getElementById('grid'), tiles = [...grid.querySelectorAll('.tile')];
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const MODES = {
  sunny: { name: 'Sonnig', clear: true, cN: 0, cloud: [250, 252, 255], sky: ['#3d7fd0', '#a9cdf0'] },
  partly: { name: 'Heiter', clear: true, cN: 0.35, cloud: [248, 250, 253], sky: ['#4a87d2', '#b3d2f0'] },
  dry: { name: 'Bewölkt', sky: ['#5a6573', '#7c8692'], cloud: [96, 104, 114] },
  drizzle: { name: 'Nieselregen', rain: 0.28, len: 0.55, wet: 0.5, sky: ['#5d6874', '#77818c'], cloud: [92, 101, 111] },
  rain: { name: 'Regen', rain: 0.7, len: 1, wet: 1, sky: ['#47515d', '#626d79'], cloud: [70, 79, 90] },
  heavy: { name: 'Starkregen', rain: 1.5, len: 1.35, wet: 1.8, sky: ['#3a424c', '#535d69'], cloud: [55, 62, 72] },
  snow: { name: 'Leichter Schneefall', snow: 0.45, capf: 0.45, capH: 1, sky: ['#7d8894', '#a6b0ba'], cloud: [132, 140, 150] },
  snowh: { name: 'Starker Schneefall', snow: 1.7, capf: 1.6, capH: 1, sky: ['#6a7480', '#929ca7'], cloud: [112, 120, 130] },
  storm: { name: 'Gewitter', rain: 1.6, len: 1.4, wet: 1.8, sky: ['#262d36', '#3e4752'], cloud: [34, 40, 48], light: true },
  sleet: { name: 'Schneeregen', rain: 0.45, len: 0.8, wet: 0.7, snow: 0.35, slush: true, sky: ['#5f6a76', '#848e99'], cloud: [100, 108, 118] },
};
// how water behaves on the glass for each kind of rain (in WeatherScope taken from mm/h and the weather condition, blended smoothly)
const WATER = {
  sunny:   { mist: 0, arr: 0, lg: 0, md: 0, dens: 900, hold: [60, 180], slip: 0, gmin: 9, hard: 0, trk: 1, maxr: 1, dryOff: true, dryF: 3 },
  partly:  { mist: 0, arr: 0, lg: 0, md: 0, dens: 900, hold: [60, 180], slip: 0, gmin: 9, hard: 0, trk: 1, maxr: 1, dryOff: true, dryF: 2 },
  dry:     { mist: 0, arr: 0, lg: 0, md: 0, dens: 900, hold: [60, 180], slip: 0, gmin: 9, hard: 0, trk: 1, maxr: 1, dryOff: true },
  drizzle: { mist: 1.6, arr: 1.2, lg: 0.0, md: 0.15, dens: 900, hold: [60, 180], slip: 0.5, smin: 2.0, gmin: 4.6, hard: 0, trk: 0.75, maxr: 2 },
  rain:    { mist: 1, arr: 1, lg: 0.1, md: 0.37, dens: 650, hold: [15, 70], slip: 1, gmin: 3.7, hard: 0.002, trk: 1, maxr: 3 },
  heavy:   { mist: 1.2, arr: 1.6, lg: 0.2, md: 0.42, dens: 420, hold: [8, 35], slip: 2.5, gmin: 3.7, hard: 0.006, trk: 1.3, maxr: 4 },
  storm:   { mist: 1.2, arr: 1.7, lg: 0.22, md: 0.42, dens: 420, hold: [8, 35], slip: 2.5, gmin: 3.7, hard: 0.007, trk: 1.3, maxr: 4 },
  sleet:   { mist: 0.8, arr: 0.7, lg: 0.03, md: 0.3, dens: 900, hold: [40, 120], slip: 0.5, smin: 2.2, gmin: 4.3, hard: 0, trk: 0.75, maxr: 2, slow: 0.6 },
  snow:    { arr: 0, lg: 0, md: 0, dens: 900, hold: [60, 180], slip: 0, gmin: 9, hard: 0, trk: 1, maxr: 1, mist: 0 },
  snowh:   { arr: 0, lg: 0, md: 0, dens: 900, hold: [60, 180], slip: 0, gmin: 9, hard: 0, trk: 1, maxr: 1, mist: 0 },
};
const WP = () => WATER[S.mode] || WATER.rain;
const S = { sunAz: null, sunEl: null, aurora: 0, tod: 'day', fog: 0, mode: 'rain', wind: 20, dir: 270, temp: -2, on: true, speed: 1 };
let wetStart = 0, W = 0, H = 0, DPR = 1, t = 0, last = 0, flash = 0, nextFlash = 3, bolt = null;
let layers = [], rain = [], snow = [], splash = [], clumps = [], lines = [], powder = [], falls = [], slabs = [];
const MAXH = 8, COL = 2;
const T = tiles.map(() => ({ cap: null, lim: null, ov: [0, 0], sag: [null, null], heaps: [], drops: [], rivs: [], merging: [], splats: [], pool: [] }));
const rnd = (a, b) => a + Math.random() * (b - a);
const pick = () => { const u = Math.random(); return u < 0.65 ? rnd(3, 10) : u < 0.92 ? rnd(10, 24) : rnd(24, 60); }; // mostly small pieces, now and then a big slab

const days = ['Heute', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So', 'Mo', 'Di'];
document.getElementById('days').innerHTML = days.map((d, i) => { const l = 10 + (i * 7) % 30, r = 15 + (i * 11) % 35; return `<div><span>${d}</span><i style="--l:${l}%;--r:${r}%"></i><span style="text-align:right">${2 + (i % 4)}° / ${6 + (i % 3)}°</span></div>`; }).join('');

function size() {
  DPR = Math.min(2, window.devicePixelRatio || 1); W = innerWidth; H = innerHeight;
  for (const c of [bg, fx]) { c.width = Math.round(W * DPR); c.height = Math.round(H * DPR); }
  B.setTransform(DPR, 0, 0, DPR, 0, 0); F.setTransform(DPR, 0, 0, DPR, 0, 0);
  const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
  grid.style.gridAutoRows = `${(grid.clientWidth - (cols - 1) * 8) / cols}px`;
  makeClouds(); makeFog(); fill();
}

// clouds: clusters of soft puffs with a light upper side and a darker base, three layers at different speeds
// soften a band that repeats endlessly: blur it together with its neighbours, so its ends join without a seam
// own blur that works in every browser (Safari ignores the canvas filter, which left hard edges):
// shrink, average the pixels three times (close to a real soft blur), enlarge again
function blurDraw(gt, src, px) {
  const sc = Math.max(1, px / 3), w = Math.max(2, Math.ceil(src.width / sc)), h = Math.max(2, Math.ceil(src.height / sc)), r = Math.max(1, Math.round(px / sc));
  const sm = document.createElement('canvas'); sm.width = w; sm.height = h; const gs = sm.getContext('2d', { willReadFrequently: true }); gs.imageSmoothingQuality = 'high';
  let cur = src, cw = src.width, chh = src.height; /* shrink in halves, so nothing gets jagged */
  while (cw / 2 > w * 1.2) { const hc = document.createElement('canvas'); hc.width = Math.ceil(cw / 2); hc.height = Math.max(1, Math.ceil(chh / 2)); hc.getContext('2d').drawImage(cur, 0, 0, hc.width, hc.height); if (cur !== src) cur.width = cur.height = 0; cur = hc; cw = hc.width; chh = hc.height; }
  gs.drawImage(cur, 0, 0, w, h); if (cur !== src) cur.width = cur.height = 0;
  const im = gs.getImageData(0, 0, w, h), d = im.data, n = w * h; let a = new Float32Array(n * 4), b = new Float32Array(n * 4);
  for (let i = 0; i < n; i++) { const al = d[i * 4 + 3] / 255; a[i * 4] = d[i * 4] * al; a[i * 4 + 1] = d[i * 4 + 1] * al; a[i * 4 + 2] = d[i * 4 + 2] * al; a[i * 4 + 3] = d[i * 4 + 3]; }
  const win = r * 2 + 1;
  for (let pass = 0; pass < 3; pass++) {
    for (let y = 0; y < h; y++) for (let c = 0; c < 4; c++) { let sum = 0; const o = y * w * 4 + c; for (let k = -r; k <= r; k++) sum += a[o + Math.min(w - 1, Math.max(0, k)) * 4]; for (let x = 0; x < w; x++) { b[o + x * 4] = sum / win; sum += a[o + Math.min(w - 1, x + r + 1) * 4] - a[o + Math.max(0, x - r) * 4]; } }
    for (let x = 0; x < w; x++) for (let c = 0; c < 4; c++) { let sum = 0; const o = x * 4 + c; for (let k = -r; k <= r; k++) sum += b[o + Math.min(h - 1, Math.max(0, k)) * w * 4]; for (let y = 0; y < h; y++) { a[o + y * w * 4] = sum / win; sum += b[o + Math.min(h - 1, y + r + 1) * w * 4] - b[o + Math.max(0, y - r) * w * 4]; } }
  }
  for (let i = 0; i < n; i++) { const al = a[i * 4 + 3]; if (al > 0.01) { const f = 255 / al; d[i * 4] = a[i * 4] * f; d[i * 4 + 1] = a[i * 4 + 1] * f; d[i * 4 + 2] = a[i * 4 + 2] * f; } d[i * 4 + 3] = al; }
  gs.putImageData(im, 0, 0); a = b = null;
  gt.imageSmoothingEnabled = true; gt.imageSmoothingQuality = 'high'; gt.drawImage(sm, 0, 0, w, h, 0, 0, src.width, src.height); sm.width = sm.height = 0;
}
// repeating bands are placed on whole screen pixels, otherwise a hairline shows where two copies meet
const snapX = (x) => Math.round(x * DPR) / DPR;
function blurWrap(raw, LW, px) {
  const pad = px * 3, wide = document.createElement('canvas'); wide.width = LW + pad * 2; wide.height = raw.height; const gw = wide.getContext('2d');
  gw.drawImage(raw, pad, 0); gw.drawImage(raw, pad - LW, 0); gw.drawImage(raw, pad + LW, 0);
  const tmp = document.createElement('canvas'); tmp.width = wide.width; tmp.height = wide.height; const gt = tmp.getContext('2d'); blurDraw(gt, wide, px);
  const cv = document.createElement('canvas'); cv.width = LW; cv.height = raw.height; cv.getContext('2d').drawImage(tmp, -pad, 0);
  wide.width = wide.height = tmp.width = tmp.height = raw.width = raw.height = 0; // free the scratch canvases right away (browsers limit canvas memory)
  return cv;
}
function makeClouds() {
  for (const l of layers) l.cv.width = l.cv.height = 0; // free the old layers
  const c = cloudCol(), col = (d, a) => `rgba(${c[0] + d},${c[1] + d},${c[2] + d},${a})`;
  layers = [0.3, 0.55, 1].map((sp, li) => {
    const LW = Math.ceil(W * 1.5 / 4) * 4, raw = document.createElement('canvas'); raw.width = LW; raw.height = H;
    const g = raw.getContext('2d');
    const cN = MODES[S.mode].cN ?? 1, clusters = Math.round((7 + li * 4) * cN), sc = (1.25 - li * 0.25) * (cN < 1 ? 0.45 : 1);
    for (let q = 0; q < clusters; q++) {
      const cx = Math.random() * LW, cy = rnd(-0.05, 0.75 - li * 0.1) * H, cw = rnd(180, 420) * sc, ch = rnd(60, 140) * sc;
      const puffs = 14 + Math.floor(Math.random() * 14);
      for (const pass of [0, 1, 2]) { // 0 dark base, 1 body, 2 light tops
        for (let k = 0; k < puffs; k++) {
          const px = cx + rnd(-cw, cw) * 0.5, py = cy + rnd(-ch, ch) * 0.5 + (pass === 0 ? ch * 0.25 : pass === 2 ? -ch * 0.25 : 0), r = rnd(40, 110) * sc * (pass === 1 ? 1 : 0.8);
          const d = pass === 0 ? -22 : pass === 2 ? 26 : 0, a = pass === 1 ? rnd(0.35, 0.55) : rnd(0.18, 0.32);
          for (const dx of [0, -LW, LW]) {
            const x = px + dx; if (x + r < 0 || x - r > LW) continue;
            const gr = g.createRadialGradient(x, py, r * 0.1, x, py, r); gr.addColorStop(0, col(d, a)); gr.addColorStop(0.6, col(d, a * 0.55)); gr.addColorStop(1, col(d, 0));
            g.fillStyle = gr; g.beginPath(); g.arc(x, py, r, 0, 7); g.fill();
          }
        }
      }
    }
    // soften once so the many faint layers don't show as grain
    const cv = blurWrap(raw, LW, MODES[S.mode].clear ? 3 : 10);
    return { cv, LW, sp, ox: Math.random() * LW };
  });
}

// time of day: clear skies get their own colours; other weather is darkened at night and warmed in the morning/evening
const CLEAR = { morning: ['#6f8fc4', '#f2b48a'], day: null, evening: ['#3f4f8a', '#ef8e6a'], night: ['#0b1430', '#1f2d55'] };
const hex = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)), mix = (a, b, f) => a.map((v, i) => Math.round(v + (b[i] - v) * f));
const fogGrey = () => ({ day: [178, 184, 190], morning: [196, 186, 178], evening: [170, 156, 150], night: [38, 42, 50] })[S.tod];
function skyCols() { const c = skyBase(), f = [0, 0.35, 0.7, 0.92][S.fog]; return f ? c.map((x) => mix(x, fogGrey(), f)) : c; } // fog turns the sky grey
function skyBase() {
  const m = MODES[S.mode];
  if (m.clear && CLEAR[S.tod]) return CLEAR[S.tod].map(hex);
  let c = m.sky.map(hex);
  if (S.tod === 'night') c = c.map((x) => mix(x, [8, 12, 26], 0.72));
  if (S.tod === 'morning') c = [mix(c[0], [150, 160, 190], 0.15), mix(c[1], [235, 185, 150], 0.3)];
  if (S.tod === 'evening') c = [mix(c[0], [80, 80, 120], 0.25), mix(c[1], [225, 140, 110], 0.3)];
  return c;
}
function cloudCol() {
  const c = MODES[S.mode].cloud;
  if (S.tod === 'night') return mix(c, [22, 28, 44], 0.86);
  if (S.tod === 'morning') return mix(c, [255, 205, 170], 0.25);
  if (S.tod === 'evening') return mix(c, [250, 160, 130], 0.3);
  return c;
}
const STARS = Array.from({ length: 160 }, () => [Math.random(), Math.pow(Math.random(), 1.4) * 0.75, rnd(0.4, 1.3), rnd(0, 6.3)]);
function moonPhase() { const d = (Date.now() / 864e5 - 10957.25) % 29.530588853; return (d < 0 ? d + 29.53 : d) / 29.530588853; } // 0 new, .5 full
let shimmer = { t: -1, next: rnd(20, 60) };
// northern lights: curtains built from narrow upright strips of light (own colours, drawn here – no image)
const AUR = [false, true].map((red) => { const c = document.createElement('canvas'); c.width = 2; c.height = 1024; const g = c.getContext('2d'), gr = g.createLinearGradient(0, 0, 0, 1024);
  (red ? [[0, '190,60,110,0'], [0.2, '190,65,130,.2'], [0.42, '170,80,165,.36'], [0.62, '90,205,160,.6'], [0.8, '125,255,175,1'], [1, '125,255,175,0']] : [[0, '90,200,170,0'], [0.3, '88,208,165,.13'], [0.6, '85,215,155,.48'], [0.8, '125,255,175,1'], [1, '125,255,175,0']]).forEach(([o, col]) => gr.addColorStop(o, `rgba(${col})`));
  g.fillStyle = gr; g.fillRect(0, 0, 2, 1024); return c; });
function drawAurora(lv) {
  const n = [0, 1, 2, 3][lv], str = [0, 0.2, 0.42, 0.62][lv], spd = [0, 0.6, 1, 1.5][lv], sw = 2, tt = t * spd;
  // drawn at half size (cheap, also for weak tablets) and blended with its neighbours in the small picture before it is enlarged:
  // that blends neighbouring points in every browser – a single enlargement showed up as a grid of little blocks
  const q = 2, aw = Math.ceil(W / q), ah = Math.ceil(H * 0.8 / q); if (!drawAurora.cv) drawAurora.cv = document.createElement('canvas'); const ac = drawAurora.cv; if (ac.width !== aw || ac.height !== ah) { ac.width = aw; ac.height = ah; }
  const A = ac.getContext('2d'); A.setTransform(1 / q, 0, 0, 1 / q, 0, 0); A.clearRect(0, 0, W, H); A.save(); A.globalCompositeOperation = 'lighter';
  // a faint glow low in the sky belongs to every level
  const gg = A.createLinearGradient(0, 0, 0, H * 0.6); gg.addColorStop(0, 'rgba(70,200,150,0)'); gg.addColorStop(0.5, `rgba(70,200,150,${0.1 * str * (0.8 + 0.2 * Math.sin(tt * 0.21))})`); gg.addColorStop(1, 'rgba(70,200,150,0)'); A.fillStyle = gg; A.fillRect(0, 0, W, H * 0.6);
  for (let ci = 0; ci < n; ci++) {
    const pulse = 0.72 + 0.28 * Math.sin(tt * 0.27 + ci * 2.1), cx = W * (0.5 + 0.3 * Math.sin(tt * 0.035 + ci * 2.4)), half = W * (0.42 + 0.12 * Math.sin(tt * 0.05 + ci)), spr = AUR[lv === 3 && ci !== 1 ? 1 : 0];
    for (let x = 0; x < W; x += sw) {
      const u = Math.abs(x - cx) / half; if (u >= 1) continue; const env = Math.pow(1 - u * u, 3); /* runs out very gently at both ends, so no upright edge shows */
      const ray = 0.5 + 0.5 * Math.sin(x * 0.085 + tt * 0.55 + ci * 1.7 + 2.6 * Math.sin(x * 0.0093 - tt * 0.17 + ci)), hs = 0.5 + 0.5 * Math.sin(x * 0.006 + tt * 0.09 + ci * 1.9), fine = 0.5 + 0.5 * Math.sin(x * 0.19 - tt * 0.9 + 1.9 * Math.sin(x * 0.021 + tt * 0.3));
      const a = str * pulse * env * (lv === 1 ? 0.72 + 0.18 * ray : 0.62 + 0.32 * ray + 0.06 * fine); /* one closed band: the rays are only lighter streaks in it, never gaps */ if (a < 0.002) continue;
      const yb = H * (0.3 + ci * 0.085) + Math.sin(x * 0.0041 + tt * 0.11 + ci * 1.3) * H * 0.055 + Math.sin(x * 0.0117 - tt * 0.07 + ci * 0.6) * H * 0.02 + Math.sin(x * 0.031 + tt * 0.13 + ci * 2) * H * 0.012; /* the lower edge is uneven too, not a straight line */
      const h = H * (0.2 + 0.05 * ci) * 1.2 * (0.8 + 0.2 * hs + 0.05 * (ray - 0.5)) * (lv === 3 ? 1.25 : 1); /* the upper edge only sways gently, no spikes */
      A.globalAlpha = Math.min(1, a); A.drawImage(spr, 0.5, 0, 1, 1024, x, yb - h, sw, h); /* exactly side by side: overlapping strips would show as fine lines */
    }
  }
  A.restore(); A.globalAlpha = 1;
  if (!drawAurora.cv2) drawAurora.cv2 = document.createElement('canvas'); const a2 = drawAurora.cv2; if (a2.width !== aw || a2.height !== ah) { a2.width = aw; a2.height = ah; }
  const A2 = a2.getContext('2d'); A2.clearRect(0, 0, aw, ah); A2.globalCompositeOperation = 'lighter'; A2.globalAlpha = 0.25;
  for (const [ox, oy] of [[0, 0], [1, 0], [0, 1], [1, 1]]) A2.drawImage(ac, ox, oy); // whole steps: needs no smoothing by the browser
  B.save(); B.globalCompositeOperation = 'lighter'; B.imageSmoothingEnabled = true; B.imageSmoothingQuality = 'high'; B.drawImage(a2, 0, 0, aw * q, ah * q); B.restore();
}
// ---- the sun: where it stands (as seen looking south: east on the left, west on the right) and the light it throws into the "lens"
// azimuth 60°…300° spans the screen, the height follows the elevation – high in summer, flat in winter
function sunPos() {
  let az = S.sunAz, el = S.sunEl;
  if (az === null || az === undefined || el === null || el === undefined) { const f = { morning: [112, 7], day: [180, 40], evening: [248, 7] }[S.tod] || [180, 40]; az = f[0]; el = f[1]; }
  const e = Math.max(0, Math.min(66, el));
  // the sun stays in the band of sky above the tiles: at the horizon it sits just above the first row (the page says where that is)
  const sky = typeof host !== 'undefined' && host.sky ? host.sky() : 0, y0 = sky ? Math.max(0.15 * H, Math.min(0.6 * H, sky - 14)) : 0.32 * H;
  return { x: Math.max(-0.06, Math.min(1.06, (az - 60) / 240)) * W, y: y0 - (y0 - 0.06 * H) * e / 66, low: Math.max(0, Math.min(1, 1 - el / 24)), el };
}
// how much cloud is in front of the sun right now (0…1), looked up a few times a second
let sunCov = 0, sunCovTo = 0, sunCovT = -9;
function sunCover(sx, sy) {
  if (t - sunCovT > 0.35) {
    sunCovT = t; let clear = 1;
    if (S.fog < 2) for (const l of layers) { try { const cw = l.cv.width, chh = l.cv.height, px = ((((sx - l.ox) % l.LW) + l.LW) % l.LW) / l.LW * cw, py = Math.max(0, Math.min(chh - 1, sy / H * chh)); const a = l.cv.getContext('2d').getImageData(Math.floor(px), Math.floor(py), 1, 1).data[3] / 255; clear *= 1 - Math.min(1, a * 1.15); } catch (e) { /* not readable: treat as clear */ } }
    sunCovTo = 1 - clear;
  }
  sunCov += (sunCovTo - sunCov) * 0.07; return sunCov;
}
const mixRGB = (a, b, f) => a.map((v, i) => Math.round(v + (b[i] - v) * f)).join(',');
// star-shaped rays around the sun and soft discs of light across the picture, as when a camera looks into the sun. Own drawing.
const RAYS = Array.from({ length: 14 }, (_, i) => ({ a: i * Math.PI * 2 / 14 + rnd(-0.07, 0.07), l: rnd(0.45, 1), w: rnd(0.7, 1.3), p: rnd(0, 6) }));
const GHOSTS = [[0.42, 15, 0, 0.17, 0], [0.7, 33, 1, 0.13, 1], [0.93, 8, 3, 0.26, 0], [1.28, 50, 2, 0.1, 1], [1.6, 21, 4, 0.11, 2], [1.94, 68, 0, 0.065, 1]]; // [place along the line, size, colour, strength, kind]
function drawSunFx(sx, sy, low, k) {
  if (k <= 0.01) return;
  const u = Math.min(W, H) / 800, warm = [255, 150, 80], pale = [255, 242, 215];
  B.save(); B.globalCompositeOperation = 'lighter';
  if (low > 0.05) { const vr = Math.max(W, H) * 0.95, vg = B.createRadialGradient(sx, sy, 0, sx, sy, vr); vg.addColorStop(0, `rgba(255,170,95,${0.16 * low * k})`); vg.addColorStop(0.45, `rgba(255,150,90,${0.06 * low * k})`); vg.addColorStop(1, 'rgba(255,150,90,0)'); B.fillStyle = vg; B.fillRect(0, 0, W, H); } // low sun: warm haze over the picture
  const RL = Math.min(W, H) * (0.135 + 0.2 * low), rc = mixRGB(pale, [255, 205, 140], low), rg = B.createRadialGradient(sx, sy, 0, sx, sy, RL);
  rg.addColorStop(0, `rgba(${rc},${0.85 * k})`); rg.addColorStop(0.25, `rgba(${rc},${0.4 * k})`); rg.addColorStop(1, `rgba(${rc},0)`); B.fillStyle = rg;
  const rot = 0.02 * Math.sin(t * 0.05);
  for (const r of RAYS) { const len = RL * r.l * (0.9 + 0.1 * Math.sin(t * 0.6 + r.p)), a = r.a + rot, wd = (1.9 + 1.9 * low) * u * r.w, ca = Math.cos(a), sa = Math.sin(a);
    B.beginPath(); B.moveTo(sx - sa * wd, sy + ca * wd); B.lineTo(sx + ca * len, sy + sa * len); B.lineTo(sx + sa * wd, sy - ca * wd); B.closePath(); B.fill(); }
