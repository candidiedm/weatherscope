    for (const l of lines) { const a = Math.sin(Math.PI * l.life / l.max) * 0.16; B.strokeStyle = `rgba(255,255,255,${a})`; B.beginPath(); B.moveTo(l.x, l.y); B.bezierCurveTo(l.x + l.len * 0.33, l.y - l.amp, l.x + l.len * 0.66, l.y + l.amp, l.x + l.len, l.y + Math.sin(l.ph) * l.amp * 0.5); B.stroke(); }
  }
  F.clearRect(0, 0, W, H);
