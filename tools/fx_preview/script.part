// the tile's top edge, which bends down into the rounded corners (radius 18 px)
const RAD = 18, edgeY = (r, x) => { const e = Math.min(x - r.left, r.right - x); return e >= RAD ? r.top : r.top + RAD - Math.sqrt(Math.max(0, RAD * RAD - (RAD - Math.max(0, e)) ** 2)); };
