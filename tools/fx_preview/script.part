    for (const [w, a] of [[8, 0.12], [3.5, 0.35], [1, 1]]) { B.strokeStyle = `rgba(225,230,255,${a})`; B.beginPath(); for (const s of bolt.segs) { B.lineWidth = w * s[4] / 2.2 + (a === 1 ? s[4] * 0.6 : 0); B.moveTo(s[0], s[1]); B.lineTo(s[2], s[3]); } B.stroke(); }
  }
