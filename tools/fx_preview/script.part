    for (const st of STARS) { const a = 0.45 + 0.4 * Math.sin(t * 1.3 + st[3]) * Math.sin(t * 0.37 + st[3] * 2); B.fillStyle = `rgba(255,255,255,${Math.max(0.08, a)})`; B.fillRect(st[0] * W, st[1] * H, st[2], st[2]); }
    if (S.aurora && !S.fog) { drawAurora(S.aurora); B.globalAlpha = fv; }
    if (meteor) { const q = meteor.life / meteor.dur, e = 1 - (1 - q) * (1 - q), d = meteor.len * e, hx = meteor.x + meteor.dx * d, hy = meteor.y + meteor.dy * d, tl = Math.min(d, meteor.tail), tx = hx - meteor.dx * tl, ty = hy - meteor.dy * tl, a = Math.sin(Math.PI * Math.min(1, q * 1.15)) * meteor.br;
      if (a > 0 && tl > 1) { const lg = B.createLinearGradient(tx, ty, hx, hy); lg.addColorStop(0, 'rgba(255,255,255,0)'); lg.addColorStop(0.7, `rgba(225,235,255,${0.35 * a})`); lg.addColorStop(1, `rgba(255,255,255,${a})`);
        B.strokeStyle = lg; B.lineWidth = 1.6; B.lineCap = 'round'; B.beginPath(); B.moveTo(tx, ty); B.lineTo(hx, hy); B.stroke(); B.fillStyle = `rgba(255,255,255,${a})`; B.beginPath(); B.arc(hx, hy, 1.4, 0, 7); B.fill(); } }
    const ph = moonPhase(), mx = W * 0.16, my = H * 0.13, mr = 22, lit = Math.cos(ph * 2 * Math.PI);
    const gl = B.createRadialGradient(mx, my, mr, mx, my, mr * 5); gl.addColorStop(0, 'rgba(220,228,255,.18)'); gl.addColorStop(1, 'rgba(220,228,255,0)'); B.fillStyle = gl; B.fillRect(mx - mr * 5, my - mr * 5, mr * 10, mr * 10);
    if (!S.fog) { B.fillStyle = 'rgba(40,48,70,.9)'; B.beginPath(); B.arc(mx, my, mr, 0, 7); B.fill(); }
    B.fillStyle = '#eef0f6'; B.beginPath(); const right = ph < 0.5; B.arc(mx, my, mr, -Math.PI / 2, Math.PI / 2, !right); B.ellipse(mx, my, Math.abs(lit) * mr, mr, 0, Math.PI / 2, -Math.PI / 2, (lit > 0) === right); B.fill(); B.globalAlpha = 1;
  }
