    B.globalAlpha = S.fog === 2 ? 0.55 : fv;
    const sp0 = sunPos(), sx = sp0.x, sy = sp0.y, sr = Math.max(W, H) * 0.55;
    const sg = B.createRadialGradient(sx, sy, 0, sx, sy, sr); const warm = mixRGB([255, 248, 225], [255, 200, 140], sp0.low);
    sg.addColorStop(0, `rgba(${warm},.75)`); sg.addColorStop(0.08, `rgba(${warm},.45)`); sg.addColorStop(0.35, `rgba(${warm},.12)`); sg.addColorStop(1, `rgba(${warm},0)`);
    B.fillStyle = sg; B.fillRect(0, 0, W, H); B.globalAlpha = 1;
  }
  B.globalAlpha = [1, 0.55, 0, 0][S.fog]; // clouds: paler in haze, gone in fog
  if (B.globalAlpha > 0) for (const l of layers) for (let x = snapX(l.ox) - l.LW; x < W; x += l.LW) B.drawImage(l.cv, x, 0, l.LW, H);
  B.globalAlpha = 1;
  if (m.clear && S.tod !== 'night' && S.fog < 2) { const sp1 = sunPos(); if (sp1.el > -1) drawSunFx(sp1.x, sp1.y, sp1.low, fv * (1 - sunCover(sp1.x, sp1.y)) * (S.fog === 1 ? 0.45 : 1) * Math.min(1, (sp1.el + 1) / 3)); }
  if (S.mode === 'partly' && S.tod !== 'night' && S.fog < 2) { const sh = Math.max(0, Math.sin(t * 0.11) * Math.sin(t * 0.047 + 1)) * 0.12; if (sh > 0.005) { B.fillStyle = `rgba(30,45,70,${sh})`; B.fillRect(0, 0, W, H); } } // a cloud shadow passes now and then
  const FOG = [0, 0.2, 0.42, 0.66][S.fog]; // milky light: clouds fade into grey
  if (FOG) { const fg = fogGrey(); B.fillStyle = `rgba(${fg},${FOG})`; B.fillRect(0, 0, W, H); }
  if (S.fog === 2 && m.clear && S.tod !== 'night') { // in fog the sun only shines through as a pale bright spot
    const sp2 = sunPos(), sx = sp2.x, sy = sp2.y, sr = Math.min(W, H) * 0.22;
    const sg = B.createRadialGradient(sx, sy, 0, sx, sy, sr); const c = mixRGB([250, 250, 245], [255, 225, 195], sp2.low);
    sg.addColorStop(0, `rgba(${c},.55)`); sg.addColorStop(0.25, `rgba(${c},.28)`); sg.addColorStop(1, `rgba(${c},0)`); B.fillStyle = sg; B.fillRect(sx - sr, sy - sr, sr * 2, sr * 2);
  }
  if (flash > 0) { B.fillStyle = `rgba(200,210,240,${flash * 0.35})`; B.fillRect(0, 0, W, H); }
