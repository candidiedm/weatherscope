    fogL.slice(0, S.fog).forEach((l, li) => { // each bank thickens and thins and spreads a little, instead of drifting
      const b = Math.sin(t * 2 * Math.PI / (18 + li * 7) + li * 2), sy = 1 + 0.06 * (b + 1), /* only ever taller than the screen: no edge at the bottom */ sx = 1 + 0.06 * Math.sin(t * 2 * Math.PI / (25 + li * 5) + li);
      B.globalAlpha = fa * (0.75 + 0.25 * b) * (1 + 0.15 * Math.sin(t * 2 * Math.PI / 90));
      for (let x = snapX(l.ox) - l.LW; x < W; x += l.LW) B.drawImage(l.cv, x, -(sy - 1) * H * 0.7, l.LW, H * sy); // only vertical swelling, so the copies still join without a seam
    });
    if (S.fog > 1 && S.wind > 25) B.globalAlpha = fa * 0.7;
    B.globalAlpha = 1;
  }
  if (lines.length) {
