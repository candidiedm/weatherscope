        for (const [wd, a0, rgb] of [[1.05, 0.2, '14,20,30'], [0.55, 0.09, '205,218,232']]) {
          const half = (n) => { const q = v.path[n]; return Math.max(0.25, q[2] * wd * 0.6 * WP().trk); };
          for (let n = 0; n < L - 1; n++) {
